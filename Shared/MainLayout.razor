@inherits LayoutComponentBase
@using MudBlazor
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<div class="page">
    <div class="mud-appbar mud-appbar-fixed-top mud-elevation-1">
        <div class="mud-toolbar mud-toolbar-gutters">
            <button type="button" class="mud-button-root mud-icon-button mud-ripple mud-ripple-icon mud-icon-button-color-inherit mud-icon-button-edge-start">
                <span class="mud-icon-button-label">
                    <svg class="mud-icon-root mud-svg-icon mud-icon-size-medium" focusable="false" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"></path>
                    </svg>
                </span>
            </button>
            <h6 class="mud-typography mud-typography-h6">
                <a href="/" style="color: inherit; text-decoration: none;">CampusSwap</a>
            </h6>
            <div class="flex-grow-1"></div>
            @if (_user != null)
            {
                <span class="mud-typography mud-typography-body1 ml-4 mr-2">@_user.Email</span>
                <button type="button" class="mud-button-root mud-icon-button mud-ripple mud-ripple-icon mud-icon-button-color-inherit mud-icon-button-edge-end" @onclick="Logout">
                    <span class="mud-icon-button-label">
                        <svg class="mud-icon-root mud-svg-icon mud-icon-size-medium" focusable="false" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"></path>
                        </svg>
                    </span>
                </button>
            }
            else
            {
                <a href="/Identity/Account/Register" class="mud-button-root mud-button mud-button-text mud-button-text-inherit mud-button-text-size-medium mud-ripple">
                    <span class="mud-button-label">Register</span>
                </a>
                <a href="/Identity/Account/Login" class="mud-button-root mud-button mud-button-text mud-button-text-inherit mud-button-text-size-medium mud-ripple">
                    <span class="mud-button-label">Login</span>
                </a>
            }
        </div>
    </div>

    <div class="main">
        <div class="content">
            @Body
        </div>
    </div>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;
    private MudTheme _currentTheme = new MudTheme();
    private AppUser? _user;
    private bool _isLoaded = false;
    
    [CascadingParameter]
    public bool IsDarkMode { get; set; }

    protected override void OnInitialized()
    {
        // Sync with the cascading parameter
        _isDarkMode = IsDarkMode;
    }
    
    protected override void OnParametersSet()
    {
        // Keep in sync with the cascading parameter
        _isDarkMode = IsDarkMode;
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isLoaded)
        {
            _isLoaded = true;
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                _user = await UserManager.GetUserAsync(authState.User);
                StateHasChanged();
            }
        }
    }

    void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    async Task ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        
        // Use JS interop to toggle dark mode class on body
        await JSRuntime.InvokeVoidAsync("setDarkMode", _isDarkMode);
        
        Snackbar.Add($"Switched to {(_isDarkMode ? "dark" : "light")} mode", Severity.Info);
        StateHasChanged();
    }

    void Changed(bool newValue)
    {
        _isDarkMode = newValue;
    }

    string GetThemeIcon()
    {
        return _isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode;
    }

    private void Logout()
    {
        Navigation.NavigateTo("/Identity/Account/Logout", forceLoad: true);
    }
    
}

